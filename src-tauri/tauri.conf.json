{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gomoku Calculator",
  "version": "0.31.0",
  "identifier": "com.gomocalc.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run serve",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gomoku Calculator",
        "width": 1100,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/engine/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/512x512.png"
    ]
  }
}
